generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccessSource {
  STRIPE
  MANUAL
}

enum EntitlementStatus {
  ACTIVE
  USED
  REVOKED
}

model RegistrationEntitlement {
  id      String            @id @default(cuid())
  email   String
  program String
  source  AccessSource
  status  EntitlementStatus @default(ACTIVE)

  stripeCustomerId     String?
  stripePaymentId      String?
  stripeSubscriptionId String?

  registeredAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

enum RoleName {
  OWNER
  COO
  MEMBER_SERVICES
  ADMINISTRATIVE_SERVICES
  TECHNICAL_SUPPORT
  TRADING_COACH
  PEER_COACH
  MEMBER
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?

  enrollments Enrollment[]
  roles       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Program {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  events      Event[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id        String  @id @default(cuid())
  userId    String
  programId String
  active    Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?

  zoomUrl String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([startsAt])
}
