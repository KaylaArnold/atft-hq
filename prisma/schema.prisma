generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccessSource {
  STRIPE
  MANUAL
}

enum EntitlementStatus {
  ACTIVE
  USED
  REVOKED
}

enum AccountabilityCycleStatus {
  ACTIVE
  COMPLETED
  EXTENDED
  CANCELLED
}

enum AccountabilityOutcome {
  GRADUATE
  CONTINUE_30_DAYS
  COACH_ARLETTA
  ACCOUNTABILITY_PARTNER
}

enum CoachingDocumentType {
  INITIAL_ASSESSMENT
  WEEKLY_CHECK_IN
  PEER_COACH_CHECK_IN
  WEEKLY_SCORECARD
  DAILY_TRADING_JOURNAL
  FINAL_REPORT_CARD
  OTHER
}

model RegistrationEntitlement {
  id      String            @id @default(cuid())
  email   String
  program String
  source  AccessSource
  status  EntitlementStatus @default(ACTIVE)

  stripeCustomerId     String?
  stripePaymentId      String?
  stripeSubscriptionId String?

  registeredAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

enum RoleName {
  OWNER
  COO
  MEMBER_SERVICES
  ADMINISTRATIVE_SERVICES
  TECHNICAL_SUPPORT
  TRADING_COACH
  PEER_COACH
  MEMBER
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?
  avatarUrl   String?

  enrollments     Enrollment[]
  roles           UserRole[]
  posts           Post[]
  reactions       Reaction[]
  monthlyBalances MonthlyBalance[]

  accountabilityCyclesAsMember    AccountabilityCycle[] @relation("AccountabilityMember")
  accountabilityCyclesAsPeerCoach AccountabilityCycle[] @relation("AccountabilityPeerCoach")
  uploadedCoachingDocuments       CoachingDocument[]    @relation("CoachingDocumentUploader")
  peerCoachAssignments            PeerCoachAssignment[] @relation("PeerCoach")
  peerCoachAssignmentsAsMember    PeerCoachAssignment[] @relation("AssignedMember")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Program {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  events               Event[]
  enrollments          Enrollment[]
  posts                Post[]
  monthlyBalances      MonthlyBalance[]
  peerCoachAssignments PeerCoachAssignment[]
  accountabilityCycles AccountabilityCycle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id        String  @id @default(cuid())
  userId    String
  programId String
  active    Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?

  zoomUrl String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([startsAt])
}

enum PostType {
  ANNOUNCEMENT
  COMMUNITY
}

model Post {
  id      String   @id @default(cuid())
  title   String?
  content String
  type    PostType @default(COMMUNITY)

  comments  Comment[]
  reactions Reaction[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([programId])
  @@index([createdAt])
}

model Comment {
  id      String @id @default(cuid())
  content String

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

enum ReactionType {
  HEART
  FIRE
  PRAISE
}

model Reaction {
  id   String       @id @default(cuid())
  type ReactionType

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model MonthlyBalance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  month Int
  year  Int

  startingBalance Decimal @db.Decimal(12, 2)
  endingBalance   Decimal @db.Decimal(12, 2)

  marker BalanceMarker?

  signature   String
  submittedAt DateTime @default(now())
  late        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId, month, year])
  @@index([programId, year, month])
  @@index([userId])
}

enum BalanceMarker {
  GREEN
  YELLOW
  RED
}

model PeerCoachAssignment {
  id String @id @default(cuid())

  peerCoachId String
  peerCoach   User   @relation("PeerCoach", fields: [peerCoachId], references: [id], onDelete: Cascade)

  memberId String
  member   User   @relation("AssignedMember", fields: [memberId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  accountabilityCycles AccountabilityCycle[]

  active Boolean @default(true)

  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, programId])
  @@index([peerCoachId])
  @@index([memberId])
  @@index([programId])
}

model AccountabilityCycle {
  id String @id @default(cuid())

  assignmentId String
  assignment   PeerCoachAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  memberId String
  member   User   @relation("AccountabilityMember", fields: [memberId], references: [id], onDelete: Cascade)

  peerCoachId String
  peerCoach   User   @relation("AccountabilityPeerCoach", fields: [peerCoachId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  status  AccountabilityCycleStatus @default(ACTIVE)
  outcome AccountabilityOutcome?

  initialAssessment InitialAccountabilityAssessment?

  completedAt DateTime?

  checkIns  CoachingCheckIn[]
  documents CoachingDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([memberId])
  @@index([peerCoachId])
  @@index([programId])
  @@index([status])
}

model CoachingDocument {
  id String @id @default(cuid())

  cycleId String
  cycle   AccountabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  type  CoachingDocumentType
  title String

  fileUrl  String?
  fileName String?

  weekNumber Int?

  uploadedByUserId String?
  uploadedByUser   User?   @relation("CoachingDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleId])
  @@index([type])
}

model CoachingCheckIn {
  id String @id @default(cuid())

  cycleId String
  cycle   AccountabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  weekNumber        Int?
  checkInDate       DateTime  @default(now())
  nextCheckInDate   DateTime?
  memberCompletedAt DateTime?
  coachReviewedAt   DateTime?

  progressStatus String?

  strengths               String?
  challenges              String?
  actionItems             String?
  coachNotes              String?
  traderQuestions         String?
  supportNeeded           String?
  journalConsistency      String?
  attendanceStatus        String?
  tradingPlanStatus       String?
  outsideSetupTrades      String?
  biggestWin              String?
  primaryEmotion          String?
  riskDiscipline          String?
  marketLesson            String?
  weeklyGoal              String?
  areasToCelebrate        String?
  areasNeedingAttention   String?
  coachEncouragement      String?
  traderSignature         String?
  coachSignature          String?
  attendanceReason        String?
  tradingPlanExplanation  String?
  outsideSetupExplanation String?
  riskComments            String?

  completed Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleId])
  @@index([checkInDate])
}

model InitialAccountabilityAssessment {
  id String @id @default(cuid())

  cycleId String              @unique
  cycle   AccountabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  strengths       String
  weaknesses      String
  stepsTaken      String
  biggestObstacle String

  commitmentScore  Int
  commitmentReason String?

  brokenTradingRule     String
  attendanceConsistency String
  journalingConsistency String
  primaryEmotion        String

  oneAreaToImprove   String
  successDefinition  String
  coachSupportNeeded String

  willingToBeAccountable    Boolean
  accountabilityExplanation String?

  personalCommitment String

  completedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
