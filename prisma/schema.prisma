generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccessSource {
  STRIPE
  MANUAL
}

enum EntitlementStatus {
  ACTIVE
  USED
  REVOKED
}

enum AccountabilityCycleStatus {
  ACTIVE
  COMPLETED
  EXTENDED
  CANCELLED
}

enum AccountabilityOutcome {
  GRADUATE
  CONTINUE_30_DAYS
  COACH_ARLETTA
  ACCOUNTABILITY_PARTNER
}

enum CoachingDocumentType {
  INITIAL_ASSESSMENT
  WEEKLY_CHECK_IN
  PEER_COACH_CHECK_IN
  WEEKLY_SCORECARD
  DAILY_TRADING_JOURNAL
  FINAL_REPORT_CARD
  OTHER
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETE
  CANCELLED
}

enum CalendarItemType {
  MEETING
  CLASS
  CONTENT
  DEADLINE
  CORPORATE
  OPERATIONS
  OTHER
}

enum CalendarItemStatus {
  SCHEDULED
  COMPLETE
  CANCELLED
}

enum LibraryDocumentType {
  SOP
  POLICY
  TEMPLATE
  TRAINING
  REFERENCE
}

enum LibraryDocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ApprovalType {
  CONTENT
  MARKETING
  PROGRAM
  FINANCIAL
  OPERATIONS
  DOCUMENT
  OTHER
}

model RegistrationEntitlement {
  id      String            @id @default(cuid())
  email   String
  program String
  source  AccessSource
  status  EntitlementStatus @default(ACTIVE)

  stripeCustomerId     String?
  stripePaymentId      String?
  stripeSubscriptionId String?

  registeredAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

enum RoleName {
  OWNER
  COO
  MEMBER_SERVICES
  ADMINISTRATIVE_SERVICES
  TECHNICAL_SUPPORT
  TRADING_COACH
  PEER_COACH
  MEMBER
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?
  avatarUrl   String?

  enrollments     Enrollment[]
  roles           UserRole[]
  posts           Post[]
  reactions       Reaction[]
  monthlyBalances MonthlyBalance[]

  accountabilityCyclesAsMember    AccountabilityCycle[]           @relation("AccountabilityMember")
  uploadedCoachingDocuments       CoachingDocument[]              @relation("CoachingDocumentUploader")
  peerCoachAssignments            PeerCoachAssignment[]           @relation("PeerCoach")
  peerCoachAssignmentsAsMember    PeerCoachAssignment[]           @relation("AssignedMember")
  accountabilityCoachAssignments  AccountabilityCoachAssignment[] @relation("AccountabilityCoachAssignments")
  accountabilityMemberAssignments AccountabilityCoachAssignment[] @relation("AccountabilityMemberAssignments")

  tasksAssigned Task[] @relation("TaskOwner")
  tasksCreated  Task[] @relation("TaskCreator")

  leadsOwned Lead[] @relation("LeadOwner")

  calendarItemsOwned   CalendarItem[] @relation("CalendarItemOwner")
  calendarItemsCreated CalendarItem[] @relation("CalendarItemCreator")

  opportunitiesOwned Opportunity[] @relation("OpportunityOwner")
  
  contentItemsOwned ContentItem[] @relation("ContentOwner")

  libraryDocumentsOwned   LibraryDocument[] @relation("LibraryDocumentOwner")
  libraryDocumentsCreated LibraryDocument[] @relation("LibraryDocumentCreator")

  approvalsRequested Approval[] @relation("ApprovalRequester")
  approvalsAssigned  Approval[] @relation("ApprovalApprover")

  revenueEntriesRecorded RevenueEntry[] @relation("RevenueRecordedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Program {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  events                         Event[]
  enrollments                    Enrollment[]
  posts                          Post[]
  monthlyBalances                MonthlyBalance[]
  peerCoachAssignments           PeerCoachAssignment[]
  accountabilityCycles           AccountabilityCycle[]
  accountabilityCoachAssignments AccountabilityCoachAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id        String  @id @default(cuid())
  userId    String
  programId String
  active    Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?

  zoomUrl String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([startsAt])
}

enum PostType {
  ANNOUNCEMENT
  COMMUNITY
}

model Post {
  id      String   @id @default(cuid())
  title   String?
  content String
  type    PostType @default(COMMUNITY)

  comments  Comment[]
  reactions Reaction[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([programId])
  @@index([createdAt])
}

model Comment {
  id      String @id @default(cuid())
  content String

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

enum ReactionType {
  HEART
  FIRE
  PRAISE
}

model Reaction {
  id   String       @id @default(cuid())
  type ReactionType

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model MonthlyBalance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  month Int
  year  Int

  startingBalance Decimal @db.Decimal(12, 2)
  endingBalance   Decimal @db.Decimal(12, 2)

  marker BalanceMarker?

  signature   String
  submittedAt DateTime @default(now())
  late        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId, month, year])
  @@index([programId, year, month])
  @@index([userId])
}

enum BalanceMarker {
  GREEN
  YELLOW
  RED
}

model PeerCoachAssignment {
  id String @id @default(cuid())

  peerCoachId String
  peerCoach   User   @relation("PeerCoach", fields: [peerCoachId], references: [id], onDelete: Cascade)

  checkIns PeerCoachCheckIn[]

  memberId String
  member   User   @relation("AssignedMember", fields: [memberId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, programId])
  @@index([peerCoachId])
  @@index([memberId])
  @@index([programId])
}

model AccountabilityCycle {
  id String @id @default(cuid())

  memberId String
  member   User   @relation("AccountabilityMember", fields: [memberId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  status  AccountabilityCycleStatus @default(ACTIVE)
  outcome AccountabilityOutcome?

  initialAssessment InitialAccountabilityAssessment?

  completedAt DateTime?

  checkIns  CoachingCheckIn[]
  documents CoachingDocument[]

  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt
  accountabilityCoachAssignment   AccountabilityCoachAssignment? @relation(fields: [accountabilityCoachAssignmentId], references: [id])
  accountabilityCoachAssignmentId String?

  @@index([memberId])
  @@index([programId])
  @@index([status])
}

model CoachingDocument {
  id String @id @default(cuid())

  cycleId String
  cycle   AccountabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  type  CoachingDocumentType
  title String

  fileUrl  String?
  fileName String?

  weekNumber Int?

  uploadedByUserId String?
  uploadedByUser   User?   @relation("CoachingDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleId])
  @@index([type])
}

model CoachingCheckIn {
  id String @id @default(cuid())

  cycleId String
  cycle   AccountabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  weekNumber        Int?
  checkInDate       DateTime  @default(now())
  nextCheckInDate   DateTime?
  memberCompletedAt DateTime?
  coachReviewedAt   DateTime?

  progressStatus String?

  strengths               String?
  challenges              String?
  actionItems             String?
  coachNotes              String?
  traderQuestions         String?
  supportNeeded           String?
  journalConsistency      String?
  attendanceStatus        String?
  tradingPlanStatus       String?
  outsideSetupTrades      String?
  biggestWin              String?
  primaryEmotion          String?
  riskDiscipline          String?
  marketLesson            String?
  weeklyGoal              String?
  areasToCelebrate        String?
  areasNeedingAttention   String?
  coachEncouragement      String?
  traderSignature         String?
  coachSignature          String?
  attendanceReason        String?
  tradingPlanExplanation  String?
  outsideSetupExplanation String?
  riskComments            String?

  completed Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleId])
  @@index([checkInDate])
}

model InitialAccountabilityAssessment {
  id String @id @default(cuid())

  cycleId String              @unique
  cycle   AccountabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  strengths       String
  weaknesses      String
  stepsTaken      String
  biggestObstacle String

  commitmentScore  Int
  commitmentReason String?

  brokenTradingRule     String
  attendanceConsistency String
  journalingConsistency String
  primaryEmotion        String

  oneAreaToImprove   String
  successDefinition  String
  coachSupportNeeded String

  willingToBeAccountable    Boolean
  accountabilityExplanation String?

  personalCommitment String

  completedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountabilityCoachAssignment {
  id String @id @default(cuid())

  accountabilityCoachId String
  accountabilityCoach   User   @relation("AccountabilityCoachAssignments", fields: [accountabilityCoachId], references: [id], onDelete: Cascade)

  memberId String
  member   User   @relation("AccountabilityMemberAssignments", fields: [memberId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  cycles AccountabilityCycle[]

  active Boolean @default(true)

  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountabilityCoachId])
  @@index([memberId])
  @@index([programId])
}

model PeerCoachCheckIn {
  id           String              @id @default(cuid())
  assignmentId String
  assignment   PeerCoachAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  weekNumber  Int
  checkInDate DateTime @default(now())

  attendedLiveSessions Boolean?
  liveSessionsAttended Int?
  watchedMissedReplays Boolean?
  missedSessionReason  String?

  totalTrades Int?
  greenTrades Int?
  redTrades   Int?

  tickers     String?
  tickerFocus String?

  tradingPlanDiscipline String?
  biggestStrength       String?
  biggestChallenge      String?
  challengeOther        String?

  beginningBalance Decimal? @db.Decimal(12, 2)
  endingBalance    Decimal? @db.Decimal(12, 2)
  weeklyGainLoss   Decimal? @db.Decimal(12, 2)
  weeklyPercentage Decimal? @db.Decimal(8, 2)

  biggestLesson   String?
  traderFeeling   String?
  traderQuestions String?
  helpNeeded      String?
  supportNextWeek String?

  strengthsNoticed String?
  focusNextWeek    String?
  actionItem       String?

  commitmentScore Int?
  moveOnePoint    String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([assignmentId, weekNumber])
  @@index([assignmentId])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(NOT_STARTED)
  priority    TaskPriority @default(NORMAL)

  dueDate     DateTime?
  completedAt DateTime?

  ownerId String?
  owner   User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model CalendarItem {
  id          String             @id @default(cuid())
  title       String
  description String?
  type        CalendarItemType   @default(OPERATIONS)
  status      CalendarItemStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime?
  allDay   Boolean   @default(false)

  location   String?
  meetingUrl String?

  ownerId String?
  owner   User?   @relation("CalendarItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CalendarItemCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([ownerId])
  @@index([type])
  @@index([status])
}

model LibraryDocument {
  id          String                @id @default(cuid())
  title       String
  description String?
  content     String?
  fileName    String?
  filePath    String?
  fileType    String?
  fileSize Int?

  type        LibraryDocumentType   @default(SOP)
  status      LibraryDocumentStatus @default(DRAFT)

  ownerId String?
  owner   User? @relation("LibraryDocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User @relation("LibraryDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([ownerId])
  @@index([updatedAt])
}

model Approval {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        ApprovalType   @default(OPERATIONS)
  status      ApprovalStatus @default(PENDING)

  dueDate DateTime?

  requesterId String
  requester   User @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  approverId String?
  approver   User? @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  contentItem ContentItem? @relation("ContentApproval")
  
  decisionNotes String?
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([approverId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}


enum LeadType {
  POTENTIAL_MEMBER
  CORPORATE
  PARTNERSHIP
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUALIFIED
  CONVERTED
  CLOSED_LOST
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  company      String?
  email        String?
  phone        String?
  type         LeadType   @default(POTENTIAL_MEMBER)
  status       LeadStatus @default(NEW)
  source       String?
  notes        String?
  nextFollowUp DateTime?

  ownerId      String?
  owner        User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([type])
  @@index([status])
  @@index([ownerId])
  @@index([nextFollowUp])
}

enum OpportunityStage {
  PROSPECTING
  CONTACTED
  DISCOVERY
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id             String           @id @default(cuid())
  title          String
  company        String
  contactName    String?
  contactEmail   String?
  description    String?
  stage          OpportunityStage @default(PROSPECTING)
  estimatedValue Decimal?         @db.Decimal(12, 2)
  nextStep       String?
  nextFollowUp   DateTime?
  expectedClose  DateTime?
  ownerId        String?
  owner          User?            @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([stage])
  @@index([ownerId])
  @@index([nextFollowUp])
  @@index([expectedClose])
}

enum RevenueSource {
  DRIPPER_PROGRAM
  MEMBERSHIP
  CLASS
  CORPORATE_PARTNERSHIP
  OTHER
}

model RevenueEntry {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(12, 2)
  source      RevenueSource
  description String?
  paymentDate DateTime
  recordedById String
  recordedBy   User         @relation("RevenueRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([paymentDate])
  @@index([source])
  @@index([recordedById])
}

enum ContentStatus {
  IDEA
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum ContentPlatform {
  ZOOM
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  TWITCH
  EMAIL
  WEBSITE
  OTHER
}

model ContentItem {
  id          String          @id @default(cuid())
  title       String
  description String?
  platform    ContentPlatform
  status      ContentStatus   @default(IDEA)
  publishDate DateTime?
  publishTime String?
  ownerId     String?
  owner       User?           @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  approvalId String?  @unique
  
  approval   Approval? @relation("ContentApproval", fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([platform])
  @@index([publishDate])
  @@index([ownerId])
}