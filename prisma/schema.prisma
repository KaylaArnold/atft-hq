generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccessSource {
  STRIPE
  MANUAL
}

enum EntitlementStatus {
  ACTIVE
  USED
  REVOKED
}

model RegistrationEntitlement {
  id      String            @id @default(cuid())
  email   String
  program String
  source  AccessSource
  status  EntitlementStatus @default(ACTIVE)

  stripeCustomerId     String?
  stripePaymentId      String?
  stripeSubscriptionId String?

  registeredAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

enum RoleName {
  OWNER
  COO
  MEMBER_SERVICES
  ADMINISTRATIVE_SERVICES
  TECHNICAL_SUPPORT
  TRADING_COACH
  PEER_COACH
  MEMBER
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?
  avatarUrl   String?

  enrollments     Enrollment[]
  roles           UserRole[]
  posts           Post[]
  reactions       Reaction[]
  monthlyBalances MonthlyBalance[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Program {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  events          Event[]
  enrollments     Enrollment[]
  posts           Post[]
  monthlyBalances MonthlyBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id        String  @id @default(cuid())
  userId    String
  programId String
  active    Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?

  zoomUrl String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([startsAt])
}

enum PostType {
  ANNOUNCEMENT
  COMMUNITY
}

model Post {
  id      String   @id @default(cuid())
  title   String?
  content String
  type    PostType @default(COMMUNITY)

  comments  Comment[]
  reactions Reaction[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([programId])
  @@index([createdAt])
}

model Comment {
  id      String @id @default(cuid())
  content String

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

enum ReactionType {
  HEART
  FIRE
  PRAISE
}

model Reaction {
  id   String       @id @default(cuid())
  type ReactionType

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model MonthlyBalance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  month Int
  year  Int

  startingBalance Decimal @db.Decimal(12, 2)
  endingBalance   Decimal @db.Decimal(12, 2)

  marker BalanceMarker?

  signature   String
  submittedAt DateTime @default(now())
  late        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId, month, year])
  @@index([programId, year, month])
  @@index([userId])
}

enum BalanceMarker {
  GREEN
  YELLOW
  RED
}
